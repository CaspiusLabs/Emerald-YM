# the chords: EDIT held + keys writes a progression (the keys' notes in the scale, up to eight); a look keeps it;
# held 1.5 s alone, random again; a tap, the next chord
listen
wait 3000
press EDIT
wait 400
said CHORDS. Keys: a progression
tapkey w0
said Fm7
tapkey w3
said NOT IN THE SCALE
tapkey w4
said Cm7
release EDIT
wait 300
said CHORDS Fm7, Cm7
expect par64 1
expect par65 8
expect par66 0
press EDIT
wait 600
release EDIT
wait 300
expect par64 1
press EDIT
wait 1700
release EDIT
wait 300
said CHORDS RANDOM
expect par64 0
tap EDIT
wait 200
said NEXT CHORD
# a progression stays with the piece, through a reboot
press EDIT
wait 400
tapkey w1
tapkey w0
release EDIT
wait 300
tap PLAY
wait 6000
expect store_writes >0
reboot
wait 1000
expect par64 3
expect par65 1

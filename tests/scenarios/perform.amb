# PERFORM (SEL): the keys mute the layers and, held, make the dub moves; SEL again gives the scale back
listen
wait 3000
expect pool 0x6AD
tap SEL
wait 200
said PERFORM ON
tapkey w3
wait 200
said KICK OFF
tapkey w0
wait 200
said CHORD OFF
key w5 down
wait 200
said THROW
wait 1500
key w5 up
key w9 down
wait 200
said ECHO
wait 1000
key w9 up
# a scale key does not change the scale while performing
tapkey b0
wait 200
expect pool 0x6AD
tapkey w3
wait 200
said KICK ON
tap SEL
wait 200
said PERFORM OFF
# the keys are the scale again (key b0 is F#: added)
tapkey b0
wait 200
said ADDED F#
expect dirty 1
# the mixer: PERFORM puts the four levels on the knobs; SEL off goes back to the page
expect view 0
tap SEL
wait 200
expect view 7
spin K2 -100
wait 200
expect par1 0
tap SEL
wait 200
expect view 0
# keys 1-3 set their Mix knob: off 0, on 100
tap SEL
wait 200
# (the mixer above left Pings at 0)
tapkey w1
wait 200
expect par1 100
said PINGS ON
tapkey w1
wait 200
expect par1 0
said PINGS OFF
tap SEL

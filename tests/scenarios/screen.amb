# the Dub page's middle: HOME again goes ripples, scope, VU meters, ripples; it is said, and kept by SAVE
wait 4000
listen
shot ripples.png
tap HOME
wait 1500
expect view 0
expect screen 1
said SCREEN SCOPE
shot scope.png
tap HOME
wait 1500
expect screen 2
said SCREEN VU
shot vu.png
# HOME from another page comes back to the Dub page, as it was
tap ENV
wait 200
tap HOME
wait 200
expect view 0
expect screen 2
tap SAVE
reboot
wait 1500
expect screen 2
tap HOME
wait 200
expect screen 0
